# Copy to .env and fill in real values. .env is git-ignored.

# Server
PORT=3000
# Hosting only. TRUST_PROXY=true when the API runs behind the host's proxy (Render), so rate
# limits use the caller's IP. WEB_PROXY_SECRET: a long random value, the SAME on the website host
# (Vercel); it lets the website pass on its visitors' IPs. Leave both empty locally.
TRUST_PROXY=
WEB_PROXY_SECRET=
# Web app origin allowed by CORS (Next.js dev server)
FRONTEND_URL=http://localhost:3001

# PostgreSQL (local install). Create the database first, e.g. `createdb civil_society_hub`.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/civil_society_hub?schema=public

# Optional, used by prisma/seed.ts for the platform's official account
OFFICIAL_ACCOUNT_NAME=واثق
OFFICIAL_ACCOUNT_EMAIL=official@civil-society-hub.local

# Auth: access tokens (JWT) and refresh tokens
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# One-time codes (sign-up, contact verification, password reset)
OTP_SECRET=change-me
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
# SMS has no provider yet (see the README). Phone sign-up is refused while this is false.
OTP_SMS_ENABLED=false

# File storage (docs/DEPLOY.md). local = a folder on this machine (development).
# s3 = an S3-compatible bucket such as Supabase Storage (hosting: the host's disk is wiped on deploy).
STORAGE_DRIVER=local
# Public base URL of this API, used to build file URLs returned to clients.
API_PUBLIC_URL=http://localhost:3000
# Folder for uploaded files in development (git-ignored).
STORAGE_LOCAL_DIR=./storage
# Signs short-lived URLs for private files (ID documents). Generate like JWT_ACCESS_SECRET.
STORAGE_SIGNING_SECRET=change-me
# Only with STORAGE_DRIVER=s3. Supabase: Storage → Settings → S3 Configuration gives the endpoint
# (https://<project>.storage.supabase.co/storage/v1/s3), the region (e.g. eu-west-1) and access keys.
# Cloudflare R2 works too (region auto). Keep the bucket private: files are served through this API.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# First platform admin, created by prisma/seed.ts (npm run db:seed -w api).
# The password is only used when the account is first created. At least 12 characters.
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@civil-society-hub.local
ADMIN_PASSWORD=change-me-at-least-12-chars

# Email delivery of one-time codes (docs/OUTSIDE-BOOTCAMP.md).
# console = write codes to the API log (development, tests).
# gmail / brevo = send real emails (docs/OUTSIDE-BOOTCAMP.md).
EMAIL_PROVIDER=console
# The name shown as the sender.
EMAIL_FROM_NAME=واثق
# Gmail: the account that sends, and a Google "app password" for it (needs 2-Step Verification).
# Never commit the real password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Brevo: SMTP & API > API keys, and a sender address verified in Brevo.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@example.com

# Events: days after an event ends (or starts, when it has no end) before missing
# documentation is reported to admins.
EVENT_DOCUMENTATION_GRACE_DAYS=7

# Push notifications through Expo (docs/OUTSIDE-BOOTCAMP.md). Off unless true: development and
# tests never call Expo. The access token is optional (only if "enhanced security" is turned
# on in the Expo project).
PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=

# Optional demo content for local testing (prisma/demo-data.ts): run the seed with
# SEED_DEMO=true. The demo accounts share DEMO_PASSWORD (8+ characters); never use it in production.
SEED_DEMO=false
DEMO_PASSWORD=

# Shared CV QR: signs the offline copy the Wathiq app can read without internet (Ed25519,
# base64 PKCS#8 DER). Empty = no offline copy (links still work online). Make one with:
#   node -e "console.log(require('crypto').generateKeyPairSync('ed25519').privateKey.export({format:'der',type:'pkcs8'}).toString('base64'))"
# Keep it secret and never change it after launch: the app checks copies with its public key
# (GET /api/v1/cv/signing-key), so a new key makes every printed QR fail the offline check.
CV_SIGNING_PRIVATE_KEY=
