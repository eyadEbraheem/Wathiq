# Base URL of the API, used only on the Next.js server (never sent to the browser).
API_URL=http://localhost:3000/api/v1

# Address of this website as other devices see it. Used in the QR of a shared CV, which is
# opened from a phone: locally use this computer's network IP (e.g. http://192.168.1.20:3001).
PUBLIC_WEB_URL=http://192.168.1.20:3001
